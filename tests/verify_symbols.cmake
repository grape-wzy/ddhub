execute_process(COMMAND "${NM}" -g --defined-only "${LIBRARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect library symbols: ${diagnostics}")
endif()
if(symbols MATCHES "[ _]ddhub_process_all([\r\n]|$)")
    message(FATAL_ERROR "Removed process_all API is still exported")
endif()
foreach(symbol IN ITEMS ddhub_process ddhub_set_process_notify)
    if(ASYNC_ENABLED)
        if(NOT symbols MATCHES "[ _]${symbol}([\r\n]|$)")
            message(FATAL_ERROR "Missing async symbol: ${symbol}")
        endif()
    elseif(symbols MATCHES "[ _]${symbol}([\r\n]|$)")
        message(FATAL_ERROR "Sync build exports async symbol: ${symbol}")
    endif()
endforeach()
